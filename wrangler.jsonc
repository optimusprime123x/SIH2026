{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lmpc-compliance-checker",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Inspection repository (schema in ./migrations — apply with `wrangler d1 migrations apply lmpc-db`)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lmpc-db",
      "database_id": "89302c1a-d8b4-41e3-8f3b-f0cf474ac3e7",
      "migrations_dir": "migrations"
    }
  ],
  // Evidence photos, stored at 512px as inspections/{id}/{n}.jpg
  "r2_buckets": [
    {
      "binding": "EVIDENCE",
      "bucket_name": "lmpc-evidence"
    }
  ]
  // Secrets — the worker rotates across ALL of these (any subset works):
  //   wrangler secret put GEMINI_API_KEY1
  //   wrangler secret put GEMINI_API_KEY2
  //   wrangler secret put GEMINI_API_KEY3
  // (GEMINI_API_KEY is also accepted; GEMINI_API_KEY4 is deliberately unused — depleted.)
  // For local dev the same names go in .dev.vars.
}
